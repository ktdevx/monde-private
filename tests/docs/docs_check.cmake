# ドキュメントの記述をビルドした monde と照合し、リポジトリ内リンクを確かめる（4.3、9.1、9.4。cmake -P で実行する）。
#   cmake -DMODE=help -DMONDE=<実行ファイル> -DSOURCE_DIR=<リポジトリのルート>
#         -DFILES=<;区切りの md> -DWORK=<作業先> [-DEXAMPLES=<docs/examples>] -P docs_check.cmake
#   cmake -DMODE=links -DSOURCE_DIR=<リポジトリのルート> -DFILES=<;区切りの md> -P docs_check.cmake
#   cmake -DMODE=notices -DSOURCE_DIR=<リポジトリのルート> -P docs_check.cmake
# MODE ごとの検査:
#   help: マーカー <!-- monde-check: help [<subcommand>] --> の直後（空行を挟まない）の
#         コードブロックの内容を、monde [<subcommand>] --help の標準出力と比べる。
#         どちらも CRLF を LF に正規化してから比べる。マーカーが FILES 全体で 0 件なら失敗。
#   quickstart: EXAMPLES の hello.md だけを WORK にコピーし、マーカー <!-- monde-check: quickstart -->
#         の直後のコードブロックの各行（# で始まる行と空行を除く）を separate_arguments(UNIX_COMMAND)
#         で分け、先頭の monde を MONDE に置き換えて WORK で実行する。終了コードが 0 でなければ失敗。
#         パイプ、リダイレクト、; と & を含む行は「検査できない行」として実行せずに失敗にする。
#         先頭の引数（monde の次）が init の行の直後に、hello.ja.po の msgstr がヘッダ以外すべて
#         空であることを確かめてから EXAMPLES の hello.ja.po で置き換える（翻訳者の編集の代わり）。
#         すべての行の後に hello.pot、hello.ja.po、hello.ja.md があり、hello.ja.md が hello.md と
#         異なることを確かめる。マーカーは FILES 全体でちょうど 1 つであること。
#   links: FILES の各ファイルからリンク [text](target) と画像 ![alt](target) を集め、target が
#         http://、https://、mailto:、# で始まるものを除き、# 以降を取り除いて、そのファイルの
#         ディレクトリからの相対パスとしてファイルかディレクトリが存在することを確かめる。
#         target は <...> の形と、後ろに続くタイトル（"..." など）を許す。/ で始まる target は
#         相対リンクではないので失敗にする。MONDE と WORK は使わない（省略できる）。
#         フェンスのコードブロック（``` と ~~~）の中とコードスパン（`...`）の中は調べない。
#         コードの例（リンクの書き方の説明など）は文書の中のリンクではないため。
#         参照形式のリンク（[text][ref] と [ref]: target）、インデントのコードブロック、
#         target の中の括弧と %xx のエンコードは扱わない（現在のドキュメントは使っていない）。
#         相対リンクが FILES 全体で 0 件なら失敗。
#   notices: SOURCE_DIR の THIRD_PARTY_NOTICES（索引）、licenses/、src/ の対応を確かめる（10.5）。
#         MONDE、WORK、FILES は使わない（省略できる）。索引の # で始まる行はコメント、空行で
#         区切った塊が 1 つの素材（CRLF は LF とみなす）。確かめること:
#         1. 各塊が ID, Name, Version, Source, License, License-File, Used-In の 7 つのキーを
#            この順にすべて持ち（Key: Value の行）、ID が ^[a-z0-9][a-z0-9-]*$ に合い索引の中で
#            一意で、License-File が licenses/<ID>.txt である。
#         2. License-File のファイルが存在し、空でない。
#         3. Used-In の各ファイル（", " で区切る）が存在し、THIRD_PARTY_NOTICES: <ID> の行を含む。
#         4. licenses/ の下に、索引の License-File にないファイルがない。
#         5. src/ の下（再帰）の .c と .h のうち THIRD_PARTY_NOTICES: <ID> の行を含むものについて、
#            その ID が索引にあり、そのファイルがその素材の Used-In にある。
#         6. 索引に塊が 1 つ以上ある。
#         ID の行は、THIRD_PARTY_NOTICES: の後に ID だけが続く行（前にコメントの記号 " * " など
#         があってよい）。THIRD_PARTY_NOTICES: の後に ID 以外が続く行は書式の誤りとして失敗にする。
# 1 つの失敗で止めず、すべてのファイルとマーカーを調べてから失敗の一覧をまとめて出す（終了コード 1）。
# Markdown の行には ; や [ ] が含まれるため、行は CMake のリストに入れず 1 行ずつ別の変数に置く。
cmake_minimum_required(VERSION 3.21)

# links と notices のモードは monde を起動せず、作業先も使わない。notices は FILES も使わない
set(required_vars MODE SOURCE_DIR)
if(NOT MODE STREQUAL "notices")
  list(APPEND required_vars FILES)
endif()
set(uses_monde TRUE)
if(MODE STREQUAL "links" OR MODE STREQUAL "notices")
  set(uses_monde FALSE)
endif()
if(uses_monde)
  list(APPEND required_vars MONDE WORK)
endif()
foreach(var IN LISTS required_vars)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message(FATAL_ERROR "docs_check: ${var} is required")
  endif()
endforeach()
get_filename_component(SOURCE_DIR "${SOURCE_DIR}" ABSOLUTE)
if(uses_monde)
  foreach(var IN ITEMS MONDE WORK)
    get_filename_component(${var} "${${var}}" ABSOLUTE)
  endforeach()
  if(NOT EXISTS "${MONDE}")
    message(FATAL_ERROR "docs_check: MONDE does not exist: ${MONDE}")
  endif()

  # 前回の出力が残らないように作業先を作り直す
  file(REMOVE_RECURSE "${WORK}")
  file(MAKE_DIRECTORY "${WORK}")
endif()

# 失敗の一覧（行に ; が含まれうるのでリストにせず改行でつなぐ）
set(failure_count 0)
set(failure_text "")
# （マクロにすると引数の中の \ や ${} が再評価されるため、関数にして呼び出し元の変数を更新する）
function(docs_check_fail text)
  math(EXPR count "${failure_count} + 1")
  set(failure_count ${count} PARENT_SCOPE)
  set(failure_text "${failure_text}  ${text}\n" PARENT_SCOPE)
endfunction()

# 照合する Markdown を絶対パスにし、存在しないファイルは失敗として記録する
set(check_files "")
foreach(md IN LISTS FILES)
  get_filename_component(md "${md}" ABSOLUTE BASE_DIR "${SOURCE_DIR}")
  if(EXISTS "${md}")
    list(APPEND check_files "${md}")
  else()
    docs_check_fail("${md}: file does not exist")
  endif()
endforeach()

# 文字列 text を 1 行ずつ <prefix>_<番号>（1 始まり）に置き、行数を <prefix>_count に置く
function(docs_check_split_lines text prefix)
  set(count 0)
  while(NOT text STREQUAL "")
    string(FIND "${text}" "\n" pos)
    math(EXPR count "${count} + 1")
    if(pos EQUAL -1)
      set(${prefix}_${count} "${text}" PARENT_SCOPE)
      set(text "")
    else()
      string(SUBSTRING "${text}" 0 ${pos} line)
      set(${prefix}_${count} "${line}" PARENT_SCOPE)
      math(EXPR pos "${pos} + 1")
      string(SUBSTRING "${text}" ${pos} -1 text)
    endif()
  endwhile()
  set(${prefix}_count ${count} PARENT_SCOPE)
endfunction()

# help モード: マーカーの直後のコードブロックと monde [<subcommand>] --help の標準出力を比べる
function(docs_check_help)
  set(marker_count 0)
  set(stdin_file "${WORK}/stdin")
  file(WRITE "${stdin_file}" "")
  foreach(md IN LISTS check_files)
    file(RELATIVE_PATH md_name "${SOURCE_DIR}" "${md}")
    file(READ "${md}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    docs_check_split_lines("${content}" doc)
    set(i 0)
    while(i LESS doc_count)
      math(EXPR i "${i} + 1")
      set(line "${doc_${i}}")
      if(NOT line MATCHES "^<!-- monde-check: help")
        continue()
      endif()
      string(REGEX REPLACE "[ \t]+$" "" line "${line}")
      set(marker_line ${i})
      set(where "${md_name}:${i}: ${line}")
      if(NOT line MATCHES "^<!-- monde-check: help( ([a-z][a-z0-9-]*))? -->$")
        docs_check_fail("${where}: malformed help marker")
        continue()
      endif()
      set(sub "${CMAKE_MATCH_2}")
      math(EXPR marker_count "${marker_count} + 1")

      # マーカーの次の行が ``` で始まるコードブロックの開始であること
      math(EXPR open "${i} + 1")
      if(open GREATER doc_count OR NOT doc_${open} MATCHES "^(```+)")
        docs_check_fail("${where}: marker without code block (the next line must start with ```)")
        continue()
      endif()
      string(LENGTH "${CMAKE_MATCH_1}" fence_length)

      # 閉じのフェンス（開始と同じ数以上の ` だけの行）までを期待する出力にする
      set(expected "")
      set(closed FALSE)
      set(j ${open})
      while(j LESS doc_count)
        math(EXPR j "${j} + 1")
        set(body "${doc_${j}}")
        if(body MATCHES "^(```+)[ \t]*$")
          string(LENGTH "${CMAKE_MATCH_1}" close_length)
          if(NOT close_length LESS fence_length)
            set(closed TRUE)
            break()
          endif()
        endif()
        string(APPEND expected "${body}\n")
      endwhile()
      if(NOT closed)
        docs_check_fail("${where}: code block is not closed")
        continue()
      endif()
      set(i ${j})

      # monde を起動して --help の標準出力を受ける
      if(sub STREQUAL "")
        set(args --help)
        set(command_text "monde --help")
        set(stem "help")
      else()
        set(args "${sub}" --help)
        set(command_text "monde ${sub} --help")
        set(stem "help-${sub}")
      endif()
      execute_process(
        COMMAND "${MONDE}" ${args}
        WORKING_DIRECTORY "${WORK}"
        INPUT_FILE "${stdin_file}"
        OUTPUT_VARIABLE actual
        ERROR_VARIABLE stderr_text
        RESULT_VARIABLE result
      )
      string(REPLACE "\r\n" "\n" actual "${actual}")
      string(STRIP "${stderr_text}" stderr_text)
      if(NOT result STREQUAL "0")
        docs_check_fail("${where}: '${command_text}' exited with ${result}: ${stderr_text}")
        continue()
      endif()
      if(expected STREQUAL actual)
        continue()
      endif()

      # 不一致: 両方を作業先に書き出し、最初に異なる行を示す
      set(expected_file "${WORK}/${stem}.line${marker_line}.expected")
      set(actual_file "${WORK}/${stem}.line${marker_line}.actual")
      file(WRITE "${expected_file}" "${expected}")
      file(WRITE "${actual_file}" "${actual}")
      docs_check_split_lines("${expected}" exp)
      docs_check_split_lines("${actual}" act)
      set(k 0)
      set(exp_line "")
      set(act_line "")
      while(k LESS exp_count OR k LESS act_count)
        math(EXPR k "${k} + 1")
        if(k GREATER exp_count)
          set(exp_line "<end of code block>")
        else()
          set(exp_line "${exp_${k}}")
        endif()
        if(k GREATER act_count)
          set(act_line "<end of output>")
        else()
          set(act_line "${act_${k}}")
        endif()
        if(NOT exp_line STREQUAL act_line)
          break()
        endif()
      endwhile()
      math(EXPR doc_line "${open} + ${k}")
      docs_check_fail("${where}: code block differs from '${command_text}' (first difference at ${md_name}:${doc_line})\n    expected (document): ${exp_line}\n    actual (monde):      ${act_line}\n    files: ${expected_file} ${actual_file}")
    endwhile()
  endforeach()
  if(marker_count EQUAL 0)
    docs_check_fail("no '<!-- monde-check: help -->' marker found in: ${FILES}")
  endif()
  set(failure_count ${failure_count} PARENT_SCOPE)
  set(failure_text "${failure_text}" PARENT_SCOPE)
  message(STATUS "docs_check: checked ${marker_count} help marker(s)")
endfunction()

# init が作った .po の msgstr がヘッダのエントリ以外すべて空であることを確かめる。
# ヘッダは msgid "" で継続行のないエントリ。それ以外のエントリの msgstr（msgstr[n] を含む）は
# msgstr "" の 1 行だけで、継続の文字列が続かないこと。訳のないエントリが 1 つもなければ失敗にする。
function(docs_check_po_untranslated po where)
  file(READ "${po}" po_content)
  string(REPLACE "\r\n" "\n" po_content "${po_content}")
  docs_check_split_lines("${po_content}" po)
  # state: none | msgid | msgstr（直前のキーワード）
  set(state none)
  set(header FALSE)
  set(entry_count 0)
  set(k 0)
  while(k LESS po_count)
    math(EXPR k "${k} + 1")
    set(po_line "${po_${k}}")
    if(po_line MATCHES "^msgid \"(.*)\"[ \t]*$")
      set(state msgid)
      if("${CMAKE_MATCH_1}" STREQUAL "")
        set(header TRUE)
      else()
        set(header FALSE)
      endif()
    elseif(po_line MATCHES "^msgid_plural ")
      set(state msgid)
      set(header FALSE)
    elseif(po_line MATCHES "^msgstr(\\[[0-9]+\\])? \"(.*)\"[ \t]*$")
      set(state msgstr)
      if(NOT header)
        math(EXPR entry_count "${entry_count} + 1")
        if(NOT "${CMAKE_MATCH_2}" STREQUAL "")
          docs_check_fail("${where}: ${po}:${k}: msgstr is not empty after init: ${po_line}")
        endif()
      endif()
    elseif(po_line MATCHES "^\"(.*)\"[ \t]*$")
      if(state STREQUAL "msgid" AND NOT "${CMAKE_MATCH_1}" STREQUAL "")
        # 継続行のある msgid "" は空の msgid ではない（ヘッダではない）
        set(header FALSE)
      elseif(state STREQUAL "msgstr" AND NOT header)
        docs_check_fail("${where}: ${po}:${k}: msgstr is not empty after init: ${po_line}")
      endif()
    else()
      set(state none)
    endif()
  endwhile()
  if(entry_count EQUAL 0)
    docs_check_fail("${where}: ${po}: init produced no entries besides the header")
  endif()
  set(failure_count ${failure_count} PARENT_SCOPE)
  set(failure_text "${failure_text}" PARENT_SCOPE)
endfunction()

# quickstart モード: マーカーの直後のコマンド列を作業先で実行し、生成物を確かめる
function(docs_check_quickstart)
  if(NOT DEFINED EXAMPLES OR EXAMPLES STREQUAL "")
    message(FATAL_ERROR "docs_check: EXAMPLES is required for MODE=quickstart")
  endif()
  get_filename_component(examples "${EXAMPLES}" ABSOLUTE BASE_DIR "${SOURCE_DIR}")
  foreach(name IN ITEMS hello.md hello.ja.po)
    if(NOT EXISTS "${examples}/${name}")
      message(FATAL_ERROR "docs_check: example does not exist: ${examples}/${name}")
    endif()
  endforeach()
  # 例の hello.md だけを作業先に置く（hello.ja.po は init の後で置き換えるときに使う）
  file(COPY "${examples}/hello.md" DESTINATION "${WORK}")
  set(stdin_file "${WORK}/.stdin")
  file(WRITE "${stdin_file}" "")

  set(marker_count 0)
  set(block_count 0)
  set(run_count 0)
  foreach(md IN LISTS check_files)
    file(RELATIVE_PATH md_name "${SOURCE_DIR}" "${md}")
    file(READ "${md}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    docs_check_split_lines("${content}" doc)
    set(i 0)
    while(i LESS doc_count)
      math(EXPR i "${i} + 1")
      set(line "${doc_${i}}")
      if(NOT line MATCHES "^<!-- monde-check: quickstart")
        continue()
      endif()
      string(REGEX REPLACE "[ \t]+$" "" line "${line}")
      set(where "${md_name}:${i}: ${line}")
      if(NOT line STREQUAL "<!-- monde-check: quickstart -->")
        docs_check_fail("${where}: malformed quickstart marker")
        continue()
      endif()
      math(EXPR marker_count "${marker_count} + 1")
      if(marker_count GREATER 1)
        docs_check_fail("${where}: more than one quickstart marker (only one command sequence is checked)")
        continue()
      endif()

      # マーカーの次の行が ``` で始まるコードブロックの開始であること
      math(EXPR open "${i} + 1")
      if(open GREATER doc_count OR NOT doc_${open} MATCHES "^(```+)")
        docs_check_fail("${where}: marker without code block (the next line must start with ```)")
        continue()
      endif()
      string(LENGTH "${CMAKE_MATCH_1}" fence_length)

      # 閉じのフェンスの位置を先に求める（閉じていなければ 1 行も実行しない）
      set(close 0)
      set(j ${open})
      while(j LESS doc_count)
        math(EXPR j "${j} + 1")
        if(doc_${j} MATCHES "^(```+)[ \t]*$")
          string(LENGTH "${CMAKE_MATCH_1}" close_length)
          if(NOT close_length LESS fence_length)
            set(close ${j})
            break()
          endif()
        endif()
      endwhile()
      if(close EQUAL 0)
        docs_check_fail("${where}: code block is not closed")
        continue()
      endif()

      # コードブロックの各行を実行する
      math(EXPR block_count "${block_count} + 1")
      math(EXPR j "${open} + 1")
      while(j LESS close)
        set(command_line "${doc_${j}}")
        set(line_where "${md_name}:${j}: ${command_line}")
        math(EXPR j "${j} + 1")
        string(STRIP "${command_line}" stripped)
        if(stripped STREQUAL "" OR stripped MATCHES "^#")
          continue()
        endif()
        # シェルの機能（パイプ、リダイレクト、コマンドの区切り）は execute_process で再現できない
        if(stripped MATCHES "[|<>;&]")
          docs_check_fail("${line_where}: uncheckable line (検査できない行: pipes, redirects, ';' and '&' are not allowed)")
          continue()
        endif()
        separate_arguments(args UNIX_COMMAND "${stripped}")
        list(GET args 0 program)
        if(NOT program STREQUAL "monde")
          docs_check_fail("${line_where}: the command must start with 'monde'")
          continue()
        endif()
        list(REMOVE_AT args 0)
        set(subcommand "")
        if(args)
          list(GET args 0 subcommand)
        endif()
        math(EXPR run_count "${run_count} + 1")
        execute_process(
          COMMAND "${MONDE}" ${args}
          WORKING_DIRECTORY "${WORK}"
          INPUT_FILE "${stdin_file}"
          OUTPUT_VARIABLE stdout_text
          ERROR_VARIABLE stderr_text
          RESULT_VARIABLE result
        )
        string(STRIP "${stderr_text}" stderr_text)
        if(NOT result STREQUAL "0")
          docs_check_fail("${line_where}: exited with ${result}: ${stderr_text}")
        endif()
        if(subcommand STREQUAL "init")
          # init の出力の訳が空であることを確かめ、用意した訳で置き換える
          if(NOT EXISTS "${WORK}/hello.ja.po")
            docs_check_fail("${line_where}: init did not create hello.ja.po")
          else()
            docs_check_po_untranslated("${WORK}/hello.ja.po" "${line_where}")
          endif()
          file(COPY_FILE "${examples}/hello.ja.po" "${WORK}/hello.ja.po")
        endif()
      endwhile()
      set(i ${close})
    endwhile()
  endforeach()
  if(marker_count EQUAL 0)
    docs_check_fail("no '<!-- monde-check: quickstart -->' marker found in: ${FILES}")
  elseif(run_count GREATER 0)
    # すべての行の後: 生成物がそろい、翻訳済みの Markdown に訳が入っていること
    foreach(name IN ITEMS hello.pot hello.ja.po hello.ja.md)
      if(NOT EXISTS "${WORK}/${name}")
        docs_check_fail("quickstart: ${name} was not created in ${WORK}")
      endif()
    endforeach()
    if(EXISTS "${WORK}/hello.ja.md")
      file(READ "${WORK}/hello.md" source_text)
      file(READ "${WORK}/hello.ja.md" translated_text)
      if(source_text STREQUAL translated_text)
        docs_check_fail("quickstart: hello.ja.md is identical to hello.md (no translation was applied)")
      endif()
    endif()
  elseif(block_count GREATER 0)
    docs_check_fail("quickstart: the code block has no command to run")
  endif()
  set(failure_count ${failure_count} PARENT_SCOPE)
  set(failure_text "${failure_text}" PARENT_SCOPE)
  message(STATUS "docs_check: ran ${run_count} quickstart command(s)")
endfunction()

# 1 行の文字列 line からコードスパンを取り除き、out_var に置く。CommonMark と同じく、
# ` の並びは同じ長さの ` の並びで閉じる。閉じのない ` の並びは文字としてそのまま残す。
# 取り除いた箇所は空白 1 つにする（前後の文字がつながって別のリンクに見えないように）。
# 行をまたぐコードスパンは扱わない。
function(docs_check_strip_code_spans line out_var)
  set(result "")
  set(rest "${line}")
  while(TRUE)
    string(FIND "${rest}" "`" pos)
    if(pos EQUAL -1)
      break()
    endif()
    string(SUBSTRING "${rest}" 0 ${pos} before)
    string(APPEND result "${before}")
    string(SUBSTRING "${rest}" ${pos} -1 rest)
    string(REGEX MATCH "^`+" open_run "${rest}")
    string(LENGTH "${open_run}" open_length)
    string(SUBSTRING "${rest}" ${open_length} -1 after)
    # 同じ長さの ` の並びを探す（長さの違う並びは読み飛ばす）
    set(search "${after}")
    set(offset 0)
    set(close_end -1)
    while(TRUE)
      string(FIND "${search}" "`" p)
      if(p EQUAL -1)
        break()
      endif()
      string(SUBSTRING "${search}" ${p} -1 tail)
      string(REGEX MATCH "^`+" run "${tail}")
      string(LENGTH "${run}" run_length)
      math(EXPR skip "${p} + ${run_length}")
      if(run_length EQUAL open_length)
        math(EXPR close_end "${offset} + ${skip}")
        break()
      endif()
      string(SUBSTRING "${search}" ${skip} -1 search)
      math(EXPR offset "${offset} + ${skip}")
    endwhile()
    if(close_end EQUAL -1)
      string(APPEND result "${open_run}")
      set(rest "${after}")
    else()
      string(APPEND result " ")
      string(SUBSTRING "${after}" ${close_end} -1 rest)
    endif()
  endwhile()
  string(APPEND result "${rest}")
  set(${out_var} "${result}" PARENT_SCOPE)
endfunction()

# links モード: 相対リンクの先が存在することを確かめる
function(docs_check_links)
  set(link_count 0)
  foreach(md IN LISTS check_files)
    file(RELATIVE_PATH md_name "${SOURCE_DIR}" "${md}")
    get_filename_component(md_dir "${md}" DIRECTORY)
    file(READ "${md}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    docs_check_split_lines("${content}" doc)
    # フェンスのコードブロックの中にいる間は fence_char と fence_length に開始のフェンスを置く
    set(in_fence FALSE)
    set(fence_char "")
    set(fence_length 0)
    set(i 0)
    while(i LESS doc_count)
      math(EXPR i "${i} + 1")
      set(line "${doc_${i}}")
      if(in_fence)
        # 閉じのフェンス: 開始と同じ文字で、開始と同じ数以上が並ぶだけの行（リストの中の字下げを許す）
        if(line MATCHES "^[ \t]*(`+|~+)[ \t]*$")
          set(run "${CMAKE_MATCH_1}")
          string(SUBSTRING "${run}" 0 1 run_char)
          string(LENGTH "${run}" run_length)
          if("${run_char}" STREQUAL "${fence_char}" AND NOT run_length LESS fence_length)
            set(in_fence FALSE)
          endif()
        endif()
        continue()
      endif()
      if(line MATCHES "^[ \t]*(```+|~~~+)")
        set(run "${CMAKE_MATCH_1}")
        string(SUBSTRING "${run}" 0 1 fence_char)
        string(LENGTH "${run}" fence_length)
        set(in_fence TRUE)
        continue()
      endif()

      docs_check_strip_code_spans("${line}" rest)
      # リンクの文字列の部分は角括弧の入れ子があり得るので、"](" から ")" までを target とする
      while("${rest}" MATCHES "\\]\\(([^)]*)\\)")
        set(raw "${CMAKE_MATCH_1}")
        set(whole "${CMAKE_MATCH_0}")
        string(FIND "${rest}" "${whole}" p)
        string(LENGTH "${whole}" whole_length)
        math(EXPR p "${p} + ${whole_length}")
        string(SUBSTRING "${rest}" ${p} -1 rest)

        # <target> の形、または target の後ろの空白以降（タイトル）を除く
        string(STRIP "${raw}" target)
        if(target MATCHES "^<([^>]*)>")
          set(target "${CMAKE_MATCH_1}")
        else()
          string(REGEX REPLACE "[ \t].*$" "" target "${target}")
        endif()
        if(target MATCHES "^(http://|https://|mailto:|#)")
          continue()
        endif()
        math(EXPR link_count "${link_count} + 1")
        string(REGEX REPLACE "#.*$" "" path "${target}")
        set(where "${md_name}:${i}")
        if(path STREQUAL "")
          docs_check_fail("${where}: empty link target: (${raw})")
        elseif(path MATCHES "^/")
          docs_check_fail("${where}: link target is not relative: ${target}")
        elseif(NOT EXISTS "${md_dir}/${path}")
          docs_check_fail("${where}: link target does not exist: ${target} (resolved: ${md_dir}/${path})")
        endif()
      endwhile()
    endwhile()
  endforeach()
  # 1 つも見つからないのは、抜き出しが壊れたか FILES の指定の誤りとみなす
  if(link_count EQUAL 0)
    docs_check_fail("no relative link found in: ${FILES}")
  endif()
  set(failure_count ${failure_count} PARENT_SCOPE)
  set(failure_text "${failure_text}" PARENT_SCOPE)
  message(STATUS "docs_check: checked ${link_count} relative link(s)")
endfunction()

# ファイル path の中の ID の行（THIRD_PARTY_NOTICES: <ID>）を探し、<prefix>_count に件数を、
# <prefix>_<k>_line に行番号（1 始まり）、<prefix>_<k>_id に ID（書式の誤りなら空）、
# <prefix>_<k>_text に行の内容を置く。行を CMake のリストに入れないため、文字列の検索で 1 件ずつ進む。
# THIRD_PARTY_NOTICES: の直前が英数字か _ のもの（別の語の一部）は ID の行とみなさない。
function(docs_check_notice_markers path prefix)
  file(READ "${path}" content)
  string(REPLACE "\r\n" "\n" content "${content}")
  set(count 0)
  set(line_no 1)
  set(rest "${content}")
  while(TRUE)
    string(FIND "${rest}" "THIRD_PARTY_NOTICES:" pos)
    if(pos EQUAL -1)
      break()
    endif()
    # pos を含む行の先頭を求め、そこまでの改行の数だけ行番号を進める
    string(SUBSTRING "${rest}" 0 ${pos} before)
    string(FIND "${before}" "\n" nl REVERSE)
    if(nl EQUAL -1)
      set(line_start 0)
    else()
      math(EXPR line_start "${nl} + 1")
      string(SUBSTRING "${before}" 0 ${line_start} consumed)
      string(REGEX REPLACE "[^\n]+" "" consumed "${consumed}")
      string(LENGTH "${consumed}" newlines)
      math(EXPR line_no "${line_no} + ${newlines}")
    endif()
    string(SUBSTRING "${rest}" ${line_start} -1 rest)
    string(FIND "${rest}" "\n" line_end)
    if(line_end EQUAL -1)
      set(line "${rest}")
      set(rest "")
    else()
      string(SUBSTRING "${rest}" 0 ${line_end} line)
      math(EXPR line_end "${line_end} + 1")
      string(SUBSTRING "${rest}" ${line_end} -1 rest)
    endif()
    string(REGEX REPLACE "\r$" "" line "${line}")
    math(EXPR at "${pos} - ${line_start}")
    string(SUBSTRING "${line}" 0 ${at} lead)
    string(SUBSTRING "${line}" ${at} -1 marker)
    if(NOT lead MATCHES "[A-Za-z0-9_]$")
      math(EXPR count "${count} + 1")
      set(${prefix}_${count}_line ${line_no} PARENT_SCOPE)
      set(${prefix}_${count}_text "${line}" PARENT_SCOPE)
      if(marker MATCHES "^THIRD_PARTY_NOTICES: ([a-z0-9][a-z0-9-]*)[ \t]*$")
        set(${prefix}_${count}_id "${CMAKE_MATCH_1}" PARENT_SCOPE)
      else()
        set(${prefix}_${count}_id "" PARENT_SCOPE)
      endif()
    endif()
    math(EXPR line_no "${line_no} + 1")
  endwhile()
  set(${prefix}_count ${count} PARENT_SCOPE)
endfunction()

# notices モード: THIRD_PARTY_NOTICES の索引と licenses/ と src/ の ID の行の対応を確かめる
function(docs_check_notices)
  set(index_name "THIRD_PARTY_NOTICES")
  set(index "${SOURCE_DIR}/${index_name}")
  set(expected_keys ID Name Version Source License License-File Used-In)
  string(REPLACE ";" ", " expected_keys_text "${expected_keys}")

  # 索引を塊に分ける。塊 n のキーの並びを block_<n>_keys に、塊の開始行を block_<n>_line に、
  # キー K の値と行番号を block_<n>_<K> と block_<n>_<K>_line に置く（同じキーが重なれば最初のもの）
  set(block_count 0)
  if(NOT EXISTS "${index}" OR IS_DIRECTORY "${index}")
    docs_check_fail("${index_name}: file does not exist (${index})")
  else()
    file(READ "${index}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    docs_check_split_lines("${content}" idx)
    set(in_block FALSE)
    set(i 0)
    while(i LESS idx_count)
      math(EXPR i "${i} + 1")
      set(line "${idx_${i}}")
      string(REGEX REPLACE "[ \t\r]+$" "" line "${line}")
      if(line MATCHES "^#")
        continue()
      endif()
      if(line MATCHES "^[ \t]*$")
        set(in_block FALSE)
        continue()
      endif()
      if(NOT in_block)
        set(in_block TRUE)
        math(EXPR block_count "${block_count} + 1")
        set(b ${block_count})
        set(block_${b}_keys "")
        set(block_${b}_line ${i})
      endif()
      if(NOT line MATCHES "^([A-Za-z][A-Za-z-]*):( (.*))?$")
        docs_check_fail("${index_name}:${i}: not a 'Key: Value' line: ${line}")
        list(APPEND block_${b}_keys "<invalid>")
        continue()
      endif()
      set(key "${CMAKE_MATCH_1}")
      string(STRIP "${CMAKE_MATCH_3}" value)
      list(APPEND block_${b}_keys "${key}")
      if(value STREQUAL "")
        docs_check_fail("${index_name}:${i}: empty value for ${key}")
      endif()
      if(NOT DEFINED block_${b}_${key}_line)
        set(block_${b}_${key} "${value}")
        set(block_${b}_${key}_line ${i})
      endif()
    endwhile()
  endif()

  # 6. 塊が 1 つ以上ある
  if(EXISTS "${index}" AND block_count EQUAL 0)
    docs_check_fail("${index_name}: no entry (at least one block of ${expected_keys_text} is required)")
  endif()

  # 1〜3. 塊ごとの確認。ID ごとの Used-In を used_in_<ID> に、ID の塊の行を id_line_<ID> に置く
  set(ids "")
  set(license_files "")
  set(b 0)
  while(b LESS block_count)
    math(EXPR b "${b} + 1")
    set(where "${index_name}:${block_${b}_line}")

    # 1. 7 つのキーがこの順にすべてある
    if(NOT "${block_${b}_keys}" STREQUAL "${expected_keys}")
      string(REPLACE ";" ", " found "${block_${b}_keys}")
      docs_check_fail("${where}: keys must be ${expected_keys_text} in this order (found: ${found})")
    endif()

    # 1. ID の書式と一意性
    set(id "")
    if(DEFINED block_${b}_ID_line)
      set(id_where "${index_name}:${block_${b}_ID_line}")
      set(raw_id "${block_${b}_ID}")
      if(NOT raw_id MATCHES "^[a-z0-9][a-z0-9-]*$")
        docs_check_fail("${id_where}: ID does not match ^[a-z0-9][a-z0-9-]*$: ${raw_id}")
      elseif(DEFINED id_line_${raw_id})
        docs_check_fail("${id_where}: duplicate ID '${raw_id}' (first at ${index_name}:${id_line_${raw_id}})")
      else()
        set(id "${raw_id}")
        set(id_line_${id} ${block_${b}_ID_line})
        set(used_in_${id} "")
        list(APPEND ids "${id}")
      endif()
    endif()

    # 1. License-File が licenses/<ID>.txt であること、2. 存在し空でないこと
    if(DEFINED block_${b}_License-File_line)
      set(lf_where "${index_name}:${block_${b}_License-File_line}")
      set(license_file "${block_${b}_License-File}")
      if(DEFINED block_${b}_ID_line AND NOT license_file STREQUAL "licenses/${block_${b}_ID}.txt")
        docs_check_fail("${lf_where}: License-File must be licenses/${block_${b}_ID}.txt (found: ${license_file})")
      endif()
      if(license_file MATCHES "[;\\\\]" OR license_file MATCHES "^/" OR license_file MATCHES "^[A-Za-z]:")
        docs_check_fail("${lf_where}: License-File must be a relative path with / separators: ${license_file}")
      elseif(NOT EXISTS "${SOURCE_DIR}/${license_file}" OR IS_DIRECTORY "${SOURCE_DIR}/${license_file}")
        docs_check_fail("${lf_where}: License-File does not exist: ${license_file}")
      else()
        file(SIZE "${SOURCE_DIR}/${license_file}" size)
        if(size EQUAL 0)
          docs_check_fail("${lf_where}: License-File is empty: ${license_file}")
        endif()
        list(APPEND license_files "${license_file}")
      endif()
    endif()

    # 3. Used-In の各ファイルが存在し、THIRD_PARTY_NOTICES: <ID> の行を含む
    if(DEFINED block_${b}_Used-In_line)
      set(ui_where "${index_name}:${block_${b}_Used-In_line}")
      set(used_in "${block_${b}_Used-In}")
      if(used_in MATCHES "[;\\\\]")
        docs_check_fail("${ui_where}: Used-In must not contain ';' or '\\': ${used_in}")
        set(used_in "")
      endif()
      string(REPLACE ", " ";" used_in_list "${used_in}")
      foreach(path IN LISTS used_in_list)
        if(path STREQUAL "" OR path MATCHES "^[ \t]|[ \t]$")
          docs_check_fail("${ui_where}: empty or badly separated entry in Used-In (separate paths with ', '): ${used_in}")
          continue()
        endif()
        if(path MATCHES "^/" OR path MATCHES "^[A-Za-z]:")
          docs_check_fail("${ui_where}: Used-In path must be relative to the repository root: ${path}")
          continue()
        endif()
        if(NOT id STREQUAL "")
          list(APPEND used_in_${id} "${path}")
        endif()
        if(NOT EXISTS "${SOURCE_DIR}/${path}" OR IS_DIRECTORY "${SOURCE_DIR}/${path}")
          docs_check_fail("${ui_where}: Used-In file does not exist: ${path}")
          continue()
        endif()
        if(id STREQUAL "")
          continue()
        endif()
        docs_check_notice_markers("${SOURCE_DIR}/${path}" mk)
        set(found FALSE)
        set(k 0)
        while(k LESS mk_count)
          math(EXPR k "${k} + 1")
          if("${mk_${k}_id}" STREQUAL "${id}")
            set(found TRUE)
            break()
          endif()
        endwhile()
        if(NOT found)
          docs_check_fail("${ui_where}: ${path} has no 'THIRD_PARTY_NOTICES: ${id}' line")
        endif()
      endforeach()
    endif()
  endwhile()

  # 4. licenses/ の下に、索引の License-File にないファイルがない
  file(GLOB_RECURSE license_dir_files LIST_DIRECTORIES false "${SOURCE_DIR}/licenses/*")
  list(SORT license_dir_files)
  foreach(path IN LISTS license_dir_files)
    file(RELATIVE_PATH rel "${SOURCE_DIR}" "${path}")
    list(FIND license_files "${rel}" found_at)
    if(found_at EQUAL -1)
      docs_check_fail("${rel}: not the License-File of any entry in ${index_name}")
    endif()
  endforeach()

  # 5. src/ の .c と .h の ID の行が索引にあり、そのファイルがその素材の Used-In にある
  file(GLOB_RECURSE src_files LIST_DIRECTORIES false "${SOURCE_DIR}/src/*.c" "${SOURCE_DIR}/src/*.h")
  list(SORT src_files)
  set(marker_total 0)
  foreach(path IN LISTS src_files)
    file(RELATIVE_PATH rel "${SOURCE_DIR}" "${path}")
    docs_check_notice_markers("${path}" mk)
    set(k 0)
    while(k LESS mk_count)
      math(EXPR k "${k} + 1")
      set(where "${rel}:${mk_${k}_line}")
      set(id "${mk_${k}_id}")
      if(id STREQUAL "")
        docs_check_fail("${where}: malformed ID line (expected 'THIRD_PARTY_NOTICES: <ID>'): ${mk_${k}_text}")
        continue()
      endif()
      math(EXPR marker_total "${marker_total} + 1")
      list(FIND ids "${id}" found_at)
      if(found_at EQUAL -1)
        docs_check_fail("${where}: ID '${id}' is not in ${index_name}")
        continue()
      endif()
      list(FIND used_in_${id} "${rel}" found_at)
      if(found_at EQUAL -1)
        docs_check_fail("${where}: ${rel} is not in Used-In of '${id}' (${index_name}:${id_line_${id}})")
      endif()
    endwhile()
  endforeach()

  set(failure_count ${failure_count} PARENT_SCOPE)
  set(failure_text "${failure_text}" PARENT_SCOPE)
  list(LENGTH license_dir_files license_count)
  message(STATUS "docs_check: checked ${block_count} entry(ies), ${license_count} license file(s), ${marker_total} ID line(s) in src/")
endfunction()

if(MODE STREQUAL "help")
  docs_check_help()
elseif(MODE STREQUAL "quickstart")
  docs_check_quickstart()
elseif(MODE STREQUAL "links")
  docs_check_links()
elseif(MODE STREQUAL "notices")
  docs_check_notices()
else()
  message(FATAL_ERROR "docs_check: unknown MODE: ${MODE} (expected: help, quickstart, links, notices)")
endif()

if(failure_count GREATER 0)
  message(FATAL_ERROR "docs_check (${MODE}): ${failure_count} failure(s)\n${failure_text}")
endif()
