# ドキュメントの記述をビルドした monde と照合する（4.3、9.1。cmake -P で実行する）。
#   cmake -DMODE=help -DMONDE=<実行ファイル> -DSOURCE_DIR=<リポジトリのルート>
#         -DFILES=<;区切りの md> -DWORK=<作業先> [-DEXAMPLES=<docs/examples>] -P docs_check.cmake
# MODE ごとの検査:
#   help: マーカー <!-- monde-check: help [<subcommand>] --> の直後（空行を挟まない）の
#         コードブロックの内容を、monde [<subcommand>] --help の標準出力と比べる。
#         どちらも CRLF を LF に正規化してから比べる。マーカーが FILES 全体で 0 件なら失敗。
# 1 つの失敗で止めず、すべてのファイルとマーカーを調べてから失敗の一覧をまとめて出す（終了コード 1）。
# Markdown の行には ; や [ ] が含まれるため、行は CMake のリストに入れず 1 行ずつ別の変数に置く。
cmake_minimum_required(VERSION 3.21)

foreach(var IN ITEMS MODE MONDE SOURCE_DIR FILES WORK)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message(FATAL_ERROR "docs_check: ${var} is required")
  endif()
endforeach()
foreach(var IN ITEMS MONDE SOURCE_DIR WORK)
  get_filename_component(${var} "${${var}}" ABSOLUTE)
endforeach()
if(NOT EXISTS "${MONDE}")
  message(FATAL_ERROR "docs_check: MONDE does not exist: ${MONDE}")
endif()

# 前回の出力が残らないように作業先を作り直す
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# 失敗の一覧（行に ; が含まれうるのでリストにせず改行でつなぐ）
set(failure_count 0)
set(failure_text "")
# （マクロにすると引数の中の \ や ${} が再評価されるため、関数にして呼び出し元の変数を更新する）
function(docs_check_fail text)
  math(EXPR count "${failure_count} + 1")
  set(failure_count ${count} PARENT_SCOPE)
  set(failure_text "${failure_text}  ${text}\n" PARENT_SCOPE)
endfunction()

# 照合する Markdown を絶対パスにし、存在しないファイルは失敗として記録する
set(check_files "")
foreach(md IN LISTS FILES)
  get_filename_component(md "${md}" ABSOLUTE BASE_DIR "${SOURCE_DIR}")
  if(EXISTS "${md}")
    list(APPEND check_files "${md}")
  else()
    docs_check_fail("${md}: file does not exist")
  endif()
endforeach()

# 文字列 text を 1 行ずつ <prefix>_<番号>（1 始まり）に置き、行数を <prefix>_count に置く
function(docs_check_split_lines text prefix)
  set(count 0)
  while(NOT text STREQUAL "")
    string(FIND "${text}" "\n" pos)
    math(EXPR count "${count} + 1")
    if(pos EQUAL -1)
      set(${prefix}_${count} "${text}" PARENT_SCOPE)
      set(text "")
    else()
      string(SUBSTRING "${text}" 0 ${pos} line)
      set(${prefix}_${count} "${line}" PARENT_SCOPE)
      math(EXPR pos "${pos} + 1")
      string(SUBSTRING "${text}" ${pos} -1 text)
    endif()
  endwhile()
  set(${prefix}_count ${count} PARENT_SCOPE)
endfunction()

# help モード: マーカーの直後のコードブロックと monde [<subcommand>] --help の標準出力を比べる
function(docs_check_help)
  set(marker_count 0)
  set(stdin_file "${WORK}/stdin")
  file(WRITE "${stdin_file}" "")
  foreach(md IN LISTS check_files)
    file(RELATIVE_PATH md_name "${SOURCE_DIR}" "${md}")
    file(READ "${md}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    docs_check_split_lines("${content}" doc)
    set(i 0)
    while(i LESS doc_count)
      math(EXPR i "${i} + 1")
      set(line "${doc_${i}}")
      if(NOT line MATCHES "^<!-- monde-check: help")
        continue()
      endif()
      string(REGEX REPLACE "[ \t]+$" "" line "${line}")
      set(marker_line ${i})
      set(where "${md_name}:${i}: ${line}")
      if(NOT line MATCHES "^<!-- monde-check: help( ([a-z][a-z0-9-]*))? -->$")
        docs_check_fail("${where}: malformed help marker")
        continue()
      endif()
      set(sub "${CMAKE_MATCH_2}")
      math(EXPR marker_count "${marker_count} + 1")

      # マーカーの次の行が ``` で始まるコードブロックの開始であること
      math(EXPR open "${i} + 1")
      if(open GREATER doc_count OR NOT doc_${open} MATCHES "^(```+)")
        docs_check_fail("${where}: marker without code block (the next line must start with ```)")
        continue()
      endif()
      string(LENGTH "${CMAKE_MATCH_1}" fence_length)

      # 閉じのフェンス（開始と同じ数以上の ` だけの行）までを期待する出力にする
      set(expected "")
      set(closed FALSE)
      set(j ${open})
      while(j LESS doc_count)
        math(EXPR j "${j} + 1")
        set(body "${doc_${j}}")
        if(body MATCHES "^(```+)[ \t]*$")
          string(LENGTH "${CMAKE_MATCH_1}" close_length)
          if(NOT close_length LESS fence_length)
            set(closed TRUE)
            break()
          endif()
        endif()
        string(APPEND expected "${body}\n")
      endwhile()
      if(NOT closed)
        docs_check_fail("${where}: code block is not closed")
        continue()
      endif()
      set(i ${j})

      # monde を起動して --help の標準出力を受ける
      if(sub STREQUAL "")
        set(args --help)
        set(command_text "monde --help")
        set(stem "help")
      else()
        set(args "${sub}" --help)
        set(command_text "monde ${sub} --help")
        set(stem "help-${sub}")
      endif()
      execute_process(
        COMMAND "${MONDE}" ${args}
        WORKING_DIRECTORY "${WORK}"
        INPUT_FILE "${stdin_file}"
        OUTPUT_VARIABLE actual
        ERROR_VARIABLE stderr_text
        RESULT_VARIABLE result
      )
      string(REPLACE "\r\n" "\n" actual "${actual}")
      string(STRIP "${stderr_text}" stderr_text)
      if(NOT result STREQUAL "0")
        docs_check_fail("${where}: '${command_text}' exited with ${result}: ${stderr_text}")
        continue()
      endif()
      if(expected STREQUAL actual)
        continue()
      endif()

      # 不一致: 両方を作業先に書き出し、最初に異なる行を示す
      set(expected_file "${WORK}/${stem}.line${marker_line}.expected")
      set(actual_file "${WORK}/${stem}.line${marker_line}.actual")
      file(WRITE "${expected_file}" "${expected}")
      file(WRITE "${actual_file}" "${actual}")
      docs_check_split_lines("${expected}" exp)
      docs_check_split_lines("${actual}" act)
      set(k 0)
      set(exp_line "")
      set(act_line "")
      while(k LESS exp_count OR k LESS act_count)
        math(EXPR k "${k} + 1")
        if(k GREATER exp_count)
          set(exp_line "<end of code block>")
        else()
          set(exp_line "${exp_${k}}")
        endif()
        if(k GREATER act_count)
          set(act_line "<end of output>")
        else()
          set(act_line "${act_${k}}")
        endif()
        if(NOT exp_line STREQUAL act_line)
          break()
        endif()
      endwhile()
      math(EXPR doc_line "${open} + ${k}")
      docs_check_fail("${where}: code block differs from '${command_text}' (first difference at ${md_name}:${doc_line})\n    expected (document): ${exp_line}\n    actual (monde):      ${act_line}\n    files: ${expected_file} ${actual_file}")
    endwhile()
  endforeach()
  if(marker_count EQUAL 0)
    docs_check_fail("no '<!-- monde-check: help -->' marker found in: ${FILES}")
  endif()
  set(failure_count ${failure_count} PARENT_SCOPE)
  set(failure_text "${failure_text}" PARENT_SCOPE)
  message(STATUS "docs_check: checked ${marker_count} help marker(s)")
endfunction()

if(MODE STREQUAL "help")
  docs_check_help()
else()
  message(FATAL_ERROR "docs_check: unknown MODE: ${MODE} (expected: help)")
endif()

if(failure_count GREATER 0)
  message(FATAL_ERROR "docs_check (${MODE}): ${failure_count} failure(s)\n${failure_text}")
endif()
